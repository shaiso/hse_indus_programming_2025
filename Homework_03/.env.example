# Required (unless USE_MOCK_LLM=true)
OPENAI_API_KEY=sk-...

# Optional — override base URL to use an OpenAI-compatible proxy
# (e.g. AiTunnel: https://api.aitunnel.ru/v1). Leave empty for stock OpenAI.
OPENAI_BASE_URL=

# Server
PORT=8080
LOG_LEVEL=info

# LLM
LLM_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4.1
LLM_TIMEOUT=60s

# Limits
MAX_REQUEST_BYTES=2097152
MAX_FILES=100
RATE_LIMIT_PER_MIN=60

# Testing
USE_MOCK_LLM=false